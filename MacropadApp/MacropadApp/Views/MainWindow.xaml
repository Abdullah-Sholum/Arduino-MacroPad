<Window x:Class="MacropadApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MacropadApp.Helpers"
        mc:Ignorable="d"
        Title="Macropad" Height="450" Width="800"
        Icon="/Assets/app_icon.ico">
    <Window.Resources>
        <local:DropdownDeleteButtonVisibilityConverter x:Key="DropdownDeleteButtonVisibilityConverter"/>
        <local:BindingProxy x:Key="ViewModelProxy" Data="{Binding}"/>
    </Window.Resources>
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Grid Margin="20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,20">
                    <TextBlock Text="MACROPAD V3"
                           Foreground="DarkSalmon"
                           FontSize="22" FontWeight="Bold"
                           HorizontalAlignment="Center"/>
                </Grid>
                <StackPanel Grid.Row="0" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <Border Width="140" Height="34"
                        Background="#000000"
                        BorderBrush="#333333"
                        BorderThickness="2"
                        CornerRadius="4"
                        Margin="0,0,0,6">
                        <Border.Effect>
                            <DropShadowEffect Color="#00FFCC" BlurRadius="12" ShadowDepth="0" Opacity="0.6"/>
                        </Border.Effect>
                        <TextBlock Text="{Binding ConnectionStatus}"
                           Foreground="#00FFCC" FontSize="11" FontFamily="Consolas"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,0">
                        <Button Content="+ Add App"
                                Command="{Binding AddAppCommand}"
                                Width="66" Height="24"
                                FontSize="10"
                                Background="#2E7D32" Foreground="White" BorderThickness="0"/>

                        <Button x:Name="ManageAppsButton"
                                Content="Delete App"
                                Click="ManageAppsButton_Click"
                                Width="66" Height="24"
                                FontSize="10"
                                Margin="8,0,0,0"
                                Background="#C62828" Foreground="White" BorderThickness="0"/>
                    </StackPanel>
                    <Popup x:Name="ManageAppsPopup"
                       IsOpen="{Binding IsManageAppsOpen, Mode=TwoWay}"
                       PlacementTarget="{Binding ElementName=ManageAppsButton}"
                       Placement="Bottom"
                       StaysOpen="True"
                       AllowsTransparency="True">
                        <Border Background="White" BorderBrush="#555555" BorderThickness="1"
                            CornerRadius="4" Padding="8" Width="180" MaxHeight="250"
                            DataContext="{Binding Data, Source={StaticResource ViewModelProxy}}">
                            <StackPanel>
                                <TextBlock Text="Aktif / Terdaftar" Foreground="Black" FontWeight="Bold"
               FontSize="11" Margin="0,0,0,6"/>

                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ActiveAppNames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding}" Foreground="Black" FontSize="11"
                                   VerticalAlignment="Center" Grid.Column="0"/>

                                                    <Button Content="✕" Grid.Column="1"
                                Width="18" Height="18" Padding="0" FontSize="10"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#FF6666"
                                Command="{Binding DataContext.DeleteAppCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>

                                <Separator Margin="0,8"/>

                                <TextBlock Text="Diabaikan" Foreground="Black" FontWeight="Bold"
               FontSize="11" Margin="0,0,0,6"/>

                                <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding IgnoredAppNames}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <TextBlock Text="{Binding}" Foreground="Gray" FontSize="11"
                                   VerticalAlignment="Center" Grid.Column="0"/>

                                                    <Button Content="↺" Grid.Column="1"
                                Width="18" Height="18" Padding="0" FontSize="10"
                                Background="Transparent" BorderThickness="0"
                                Foreground="#66AAFF"
                                Command="{Binding DataContext.UnignoreAppCommand,
                                          RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{Binding}"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </StackPanel>
                        </Border>
                    </Popup>

                </StackPanel>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Grid.Row="1" Margin="20">

                    <!-- Slider 2-6: hasil perulangan dari Sliders collection -->
                    <ItemsControl ItemsSource="{Binding Sliders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="15,0,15,0" Width="70">
                                    <TextBlock Text="{Binding SliderNumber, StringFormat=SLIDER {0}}"
                                           Foreground="Black" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                                    <Slider Minimum="0" Maximum="100"
                                        Value="{Binding Value, Mode=TwoWay}"
                                        Orientation="Vertical" Height="200" HorizontalAlignment="Center"/>

                                    <TextBlock Text="{Binding Value, StringFormat={}{0:F0}%}"
                                           Foreground="Black" HorizontalAlignment="Center" Margin="0,5,0,5"/>

                                    <ComboBox ItemsSource="{Binding AvailableApps}"
                                        SelectedItem="{Binding AssignedApp, Mode=TwoWay}"
                                        Background="#2D2D2D" Foreground="Black">
                                    </ComboBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Slider 1: master volume, tetap terpisah dari perulangan -->
                    <StackPanel Margin="15,0,15,0" Width="70">
                        <TextBlock Text="SLIDER 1" Foreground="#FF007F" FontWeight="Bold"
                                HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <Slider Minimum="0" Maximum="100"
                            Value="{Binding MasterVolume, Mode=TwoWay}"
                            Orientation="Vertical" Height="200" HorizontalAlignment="Center"
                            Foreground="#FF007F" ValueChanged="Slider_ValueChanged"/>
                        <TextBlock Text="{Binding MasterVolume, StringFormat={}{0:F0}%}"
                                Foreground="#FF007F" FontWeight="Bold"
                                HorizontalAlignment="Center" Margin="0,5,0,5"/>
                        <ComboBox SelectedIndex="0" IsEnabled="False">
                            <ComboBoxItem Content="System"/>
                        </ComboBox>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
